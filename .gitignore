build/*
!build/.void
.wget-hsts
.bash_history
.lesshst
.viminfo
.vscode
environment/*/*/build/**
environment/*/*/output/boot/Image
environment/*/*/output/rootfs/*
environment/*/*/install/lib/modules/*
environment/*/*/install/lib/firmware/RPU-demo-*
environment/*/*/install/root/tests/test_omnivisor_guest/experiments/boot_exp/inmates/RPU/*
environment/*/*/install/root/tests/test_omnivisor_guest/experiments/boot_exp/inmates/APU/*
environment/*/*/install/root/tests/test_omnivisor_guest/experiments/boot_exp/inmates/RISCV/*
# Personal ssh keys for the target, kept local to each developer's clone
environment/*/*/install/root/.ssh/
scripts/common/current_environment.sh
runPHI/rust_runphi/target/*

# Session handoff notes, not part of the environment definition
HANDOFF_*.md
# Home-directory files created by the docker build environment (HOME is the
# checkout): .bashrc, and Go's telemetry directory (Buildroot's host-go)
.bashrc
/.config/
# Local revert points made while changing configs / images
*.pre-scheddebug.bak
tftpboot/*/Image.*.bak
# QEMU boots output/boot/Image: its copy in tftpboot (linux_compile.sh) is unused
tftpboot/qemu-*/
# The environment each board boots over TFTP, selected on the TFTP server by
# scripts/remote/switch_backend.sh (links to <target>-<backend>/boot.scr)
tftpboot/*.scr
