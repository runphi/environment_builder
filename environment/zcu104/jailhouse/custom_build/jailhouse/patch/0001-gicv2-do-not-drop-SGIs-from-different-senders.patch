diff --git a/hypervisor/arch/arm-common/gic-v2.c b/hypervisor/arch/arm-common/gic-v2.c
index 83811f1..1fb11bf 100755
--- a/hypervisor/arch/arm-common/gic-v2.c
+++ b/hypervisor/arch/arm-common/gic-v2.c
@@ -314,8 +314,63 @@ static int gicv2_inject_irq(u16 irq_id, u16 sender)
 
 		/* Check that there is no overlapping */
 		lr = gicv2_read_lr(n);
-		if ((lr & GICH_LR_VIRT_ID_MASK) == irq_id)
-			return -EEXIST;
+		if ((lr & GICH_LR_VIRT_ID_MASK) == irq_id) {
+			/*
+			 * For an SGI the source CPU is part of the interrupt's
+			 * identity, not incidental data: real GICv2 keeps SGI
+			 * pending state per source (GICD_SPENDSGIR/CPENDSGIR
+			 * are one byte per SGI, one bit per source CPU).
+			 * Matching on the virtual ID alone treats an SGI from a
+			 * *different* CPU as a duplicate and drops it --
+			 * irqchip_inject_pending() advances head on -EEXIST and
+			 * irqchip_set_pending() returns early, so nothing
+			 * retries it.
+			 *
+			 * That silently loses wakeup IPIs. Measured on this
+			 * board 2026-08-06: "cpu1 SGI 1 from cpu0 coalesced",
+			 * immediately followed by rcu_preempt stuck in
+			 * TASK_WAKING on cpu1 and an RCU stall -- SGI 1 is
+			 * IPI_CALL_FUNC, the IPI that makes a CPU drain its
+			 * ttwu wake_list.
+			 *
+			 * So only collapse an SGI onto an in-flight one when
+			 * the sender matches too. Distinct senders get their
+			 * own list register, or -EBUSY and the pending ring,
+			 * which retries correctly.
+			 */
+			if (!is_sgi(irq_id) ||
+			    ((lr >> GICH_LR_CPUID_SHIFT) & 0x7) ==
+			    (sender & 0x7)) {
+				/*
+				 * Same interrupt from the same source. On real
+				 * hardware setting the pending bit while the
+				 * interrupt is *active* (being serviced) leaves
+				 * it pending again, so it fires a second time
+				 * once the guest EOIs. Dropping it here instead
+				 * loses the second event -- the same failure as
+				 * above, just narrower: the guest has already
+				 * read this IRQ from IAR and will not look
+				 * again unless we re-arm it.
+				 *
+				 * List registers model exactly this with the
+				 * pending+active state, so use it.
+				 */
+				if ((lr & GICH_LR_ACTIVE_BIT) &&
+				    !(lr & GICH_LR_PENDING_BIT)) {
+					gicv2_write_lr(n,
+						       lr | GICH_LR_PENDING_BIT);
+					return 0;
+				}
+
+				/*
+				 * Already pending: genuine coalescing. Hardware
+				 * does the same -- a pending SGI from one source
+				 * is a single bit, so a second one before the
+				 * first is taken adds nothing.
+				 */
+				return -EEXIST;
+			}
+		}
 	}
 
 	if (first_free == -1)
diff --git a/hypervisor/arch/arm-common/include/asm/irqchip.h b/hypervisor/arch/arm-common/include/asm/irqchip.h
index 06401f9..0c2c719 100755
--- a/hypervisor/arch/arm-common/include/asm/irqchip.h
+++ b/hypervisor/arch/arm-common/include/asm/irqchip.h
@@ -76,6 +76,23 @@ struct pending_irqs {
 	unsigned int head;
 	/* removal from the ring happens lockless, thus tail is volatile */
 	volatile unsigned int tail;
+	/*
+	 * Interrupts discarded because the ring was full. Written under lock.
+	 * Non-zero means the guest has silently lost interrupts -- see the
+	 * comment in irqchip_set_pending().
+	 *
+	 * MEASURED 2026-08-06: stays 0 across a run that produced three RCU
+	 * stalls, so ring overflow is NOT the cause of the lost wakeups.
+	 */
+	unsigned int dropped;
+	/*
+	 * SGIs discarded because inject_irq() reported -EEXIST: an SGI with the
+	 * same interrupt ID was already in a list register. gicv2_inject_irq()
+	 * compares only the virtual ID and ignores the sender, while real GICv2
+	 * tracks SGI pending state per source CPU -- so two SGIs with the same
+	 * ID from different CPUs collapse into one and the second is lost.
+	 */
+	unsigned int sgi_coalesced;
 };
 
 int irqchip_cpu_init(struct per_cpu *cpu_data);
