# Static address, the same in both boot modes, and the only one: there is no
# DHCP client (the DNS server is in /etc/resolv.conf):
# - booted from the SD card, ifup configures eth1 with it;
# - with an NFS root, nfs_check makes ifup leave eth1 alone: the kernel has
#   already configured it from the ip= argument of boot_tftp.cmd, and taking it
#   down would cut off the root filesystem.
#
# eth1 is the PS GEM0 port, J10D (ethernet@ff0b0000), where the cable goes.
# GEM0's PHY is on the MDIO bus of GEM1 (J10C), so GEM0 probes after GEM1 and
# gets the second name: eth0 is GEM1, J10C, which stays unconfigured.

auto lo
iface lo inet loopback

auto eth1
iface eth1 inet static
  pre-up /etc/network/nfs_check
  address 192.168.100.53
  netmask 255.255.255.0
  gateway 192.168.100.254
