#!/bin/bash

# eth0 of the QEMU VM. With QEMU_NET="slirp", udhcpc (S40network) has already
# configured it from QEMU's DHCP server. With QEMU_NET="tap", br0 has no DHCP
# server: start_qemu.sh passes ${IP} of environment_cfgs/qemu-<backend>.sh and
# br0's address on the kernel command line, and they are set here.

[ "$1" = "stop" ] && exit 0

ETH0_NAME="eth0"
ETH0_IP=""
DEFAULT_GATEWAY=""
for param in $(cat /proc/cmdline); do
  case "${param}" in
  runphi.tap_ip=*) ETH0_IP=${param#*=} ;;
  runphi.tap_gw=*) DEFAULT_GATEWAY=${param#*=} ;;
  esac
done

if [ -z "${ETH0_IP}" ]; then
  echo "${ETH0_NAME}: no runphi.tap_ip on the kernel command line, keeping its DHCP configuration"
  exit 0
fi

ip link set ${ETH0_NAME} up
ip addr add ${ETH0_IP} dev ${ETH0_NAME}
echo "Added ${ETH0_IP} to ${ETH0_NAME} (tap0 on the host)"

# Default route through the host's bridge
ip route add default via ${DEFAULT_GATEWAY}

echo "nameserver 8.8.8.8" > /etc/resolv.conf
